<!-- ═══ SIX GODS ════════════════════════════════════════ -->
<section id="components">
  <div class="page">
    <div class="tag tag-violet">Components</div>
    <h2>Six gods. One platform.<br><span class="gradient-text">Complete coverage.</span></h2>
    <div class="component-grid">
      <div class="component-card cc-hermes">
        <div class="cc-name" style="color:#22d3ee">Hermes</div>
        <div class="cc-role">Protocol Router</div>
        <div class="cc-desc">The universal translator. Hermes speaks every wireless, transport and RAN management protocol natively — routing, transforming, and normalizing device telemetry from any vendor into a single internal event stream.</div>
        <div class="cc-pills">
          <span class="pill">uCentral</span><span class="pill">TR-369/USP · 4 MTPs</span><span class="pill">WRP/Xmidt</span><span class="pill">IEEE 1905.1</span><span class="pill">OpenSync</span><span class="pill">MQTT</span><span class="pill">NETCONF</span><span class="pill">SNMP</span><span class="pill">gNMI</span><span class="pill">O-RAN A1/VES</span>
        </div>
      </div>
      <div class="component-card cc-meridian">
